#!/bin/bash
while ! ping -c 1 -n -w 1 google.com &>/dev/null
do
  echo "Waiting for google.com to be pingable"
done
set -euxo pipefail
yum update -y
/usr/libexec/oci-growfs --yes
dnf config-manager --enable ol10_developer
dnf install podman python3-pip python-oci-cli acl -y
dnf install dnf-plugins-core
dnf copr enable @caddy/caddy -y
while fuser /usr/lib/sysimage/rpm/.rpm.lock >/dev/null 2>&1; do
  echo "Waiting for RPM database lock..."
  sleep 2
done
dnf install caddy -y
cat >/etc/caddy/Caddyfile <<END_CADDYFILE
{
  storage file_system /mnt/data/caddy
}

${fqdn} {
  reverse_proxy http://localhost:3000
}
END_CADDYFILE
install -d -o opc -g opc /home/opc/rallly-selfhosted
cat >/home/opc/rallly-selfhosted/config.env <<END_CONFIG
# Generated config for tag ${rallly-container-tag} - force regen
NEXT_PUBLIC_BASE_URL=https://${fqdn}
%{ if allowed_emails != "" ~}
ALLOWED_EMAILS=${allowed_emails}
%{ endif ~}
SUPPORT_EMAIL=hello@${fqdn}
NOREPLY_EMAIL=noreply@${fqdn}
SMTP_SECURE=true
SMTP_HOST=${smtp_host}
SMTP_PORT=465
SMTP_USER=${smtp_user}
INITIAL_ADMIN_EMAIL=${initial_admin_email}
END_CONFIG
SMTP_PWD=`oci secrets secret-bundle get \
    --raw-output \
    --auth instance_principal \
    --secret-id ${smtp_password_secret_ocid} \
    --query "data.\"secret-bundle-content\".content" | base64 -d`
echo SMTP_PWD=$SMTP_PWD >>/home/opc/rallly-selfhosted/config.env
# In config.env set ALLOWED_EMAILS (*@oracle.com) or similar
oci os object get -bn ${deploy_bucket_name} --name "deploy/docker-compose.yml" --file "/home/opc/rallly-selfhosted/docker-compose.yml" -ns ${objectstorage_namespace} --auth instance_principal
su - opc -c 'pip3 install podman-compose'
set +e
blkid /dev/oracleoci/oraclevdb
if [ $? -eq 2 ]; then
  # disk needs formatting before mounting
  mkfs.xfs /dev/oracleoci/oraclevdb
fi
mkdir /mnt/data
set -e
echo "/dev/oracleoci/oraclevdb /mnt/data xfs defaults,_netdev,nofail 0 2" >>/etc/fstab
systemctl daemon-reload && mount -a
if [ ! -d /mnt/data/psqldata ]; then
  mkdir /mnt/data/psqldata
fi
if [ ! -d /mnt/data/caddy ]; then
  mkdir /mnt/data/caddy
fi
chown opc:opc -R /mnt/data
chown caddy:caddy -R /mnt/data/caddy
install -d -o root -g root -m 0700 /mnt/data/rallly-secrets
SECRET_PASSWORD_FILE=/mnt/data/rallly-secrets/secret_password
if [ ! -f "$SECRET_PASSWORD_FILE" ]; then
  openssl rand -base64 32 >"$SECRET_PASSWORD_FILE"
fi
chown root:root "$SECRET_PASSWORD_FILE"
chmod 0600 "$SECRET_PASSWORD_FILE"
SECRET_PASSWORD=$(cat "$SECRET_PASSWORD_FILE")
printf 'SECRET_PASSWORD=%s\n' "$SECRET_PASSWORD" >>/home/opc/rallly-selfhosted/config.env
install -d -o opc -g opc -m 0755 /var/log/rallly
touch /var/log/rallly/rallly.log /var/log/rallly/postgres.log
chown opc:opc /var/log/rallly/rallly.log /var/log/rallly/postgres.log
chmod 0644 /var/log/rallly/rallly.log /var/log/rallly/postgres.log
if id oracle-cloud-agent >/dev/null 2>&1; then
  setfacl -m u:oracle-cloud-agent:rx /var/log/rallly
  setfacl -m u:oracle-cloud-agent:r /var/log/rallly/rallly.log /var/log/rallly/postgres.log
  setfacl -d -m u:oracle-cloud-agent:rx /var/log/rallly
fi
#su - opc -c 'cd rallly-selfhosted && podman compose --pod-args "--userns keep-id" up -d'
su - opc -c 'cd rallly-selfhosted && podman compose systemd -a create-unit'
oci os object get -bn ${deploy_bucket_name} --name "deploy/podman-compose.service" --file "/etc/systemd/user/podman-compose@.service" -ns ${objectstorage_namespace} --auth instance_principal
su - opc -c 'cd rallly-selfhosted && podman compose systemd -a register'
su - opc -c 'echo PODMAN_USERNS=keep-id >>~/.config/containers/compose/projects/rallly-selfhosted.env'
loginctl enable-linger 'opc'
systemctl start user@$(id -u opc).service
sudo -u opc XDG_RUNTIME_DIR=/run/user/$(id -u opc) \
  systemctl --user start 'podman-compose@rallly-selfhosted'
sudo -u opc XDG_RUNTIME_DIR=/run/user/$(id -u opc) \
  systemctl --user enable 'podman-compose@rallly-selfhosted'
sudo -u opc XDG_RUNTIME_DIR=/run/user/$(id -u opc) \
  systemctl --user status 'podman-compose@rallly-selfhosted'
firewall-cmd --permanent --add-service=http
firewall-cmd --permanent --add-service=https
firewall-cmd --reload
semanage fcontext -a -t httpd_sys_rw_content_t /mnt/data/caddy
restorecon -v /mnt/data/caddy
systemctl start caddy
systemctl enable caddy
mkdir -p /etc/systemd/system/caddy.service.d/
echo "Requires=network-online.target mnt-data.mount" >/etc/systemd/system/caddy.service.d/override.conf
